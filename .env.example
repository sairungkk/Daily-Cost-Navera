# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามที่ต้องการ
#   Windows: copy .env.example .env
# หมายเหตุ: ถ้ารหัสผ่านมีอักขระ # ให้ครอบค่าด้วยเครื่องหมายคำพูด เช่น STAFF_PASSWORD="abc#123"
ADMIN_PASSWORD=ตั้งรหัสผ่านผู้ดูแลระบบ
STAFF_PASSWORD=ตั้งรหัสผ่านพนักงาน

# พอร์ตของเซิร์ฟเวอร์ (ค่าเริ่มต้น 3500)
PORT=3500
